@model ProjetERP.ViewModels.ClientViewModel

@{
    ViewData["Title"] = "Supprimer un client";
}

<h2>Supprimer un client</h2>

<h3>Êtes-vous sûr de vouloir supprimer ce client ?</h3>
<div>
    <h4>Client</h4>
    <dl class="row">
        <dt class="col-sm-2">Nom</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.ContactEmail</dd>
        <dt class="col-sm-2">Téléphone</dt>
        <dd class="col-sm-10">@Model.Phone</dd>
        <dt class="col-sm-2">Adresse</dt>
        <dd class="col-sm-10">@Model.Address</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ClientId" />
        <button type="submit" class="btn btn-danger">Supprimer</button>
        <a asp-action="Index" class="btn btn-secondary">Annuler</a>
    </form>
</div>
